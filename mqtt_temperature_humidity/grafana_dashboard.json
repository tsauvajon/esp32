{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.4.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "9.4.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "9.4.0"
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": "9.4.0"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": "9.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1710000000000,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature & Humidity",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Temp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "temperature_celsius{payload=\"telemetry\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}} - Temp"
        },
        {
          "refId": "B",
          "expr": "humidity_percent{payload=\"telemetry\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}} - Humidity"
        }
      ]
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Device Online State",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Offline", "color": "red" }, "1": { "text": "Online", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "options": {
        "mergeValues": true,
        "legend": { "displayMode": "hidden" },
        "rowHeight": 0.9,
        "showValue": "never"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "online{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Wi-Fi Signal (RSSI)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": -70, "color": "orange" },
              { "value": -60, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wifi_rssi_dbm{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (org, location, deviceid) (uptime_seconds{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heap Usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "custom": { "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "heap_used_bytes{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}} - Used"
        },
        {
          "refId": "B",
          "expr": "heap_total_bytes{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"} - heap_used_bytes{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}} - Free"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Heap Utilization %",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(heap_used_bytes{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"} / heap_total_bytes{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}) * 100",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Last Successful Sensor Read (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_sensor_ok_seconds{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Wi-Fi Channel",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(wifi_channel{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}[$__interval])",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Last Reset Reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "blue", "value": null } ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "legend": { "displayMode": "list" },
        "rowHeight": 0.9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "device_reset_reason_info{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "legendFormat": "{{org}}/{{location}}/{{deviceid}} - {{reset_reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Device Metadata",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "value" } },
        { "id": "organize", "options": { "indexByName": { "Value": -1 }, "renameByName": { "Value": "Announce" } } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "device_metadata_info{payload=\"status\",org=~\"$org\",location=~\"$location\",deviceid=~\"$deviceid\"}",
          "instant": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["esp32", "mqtt", "environment"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "org",
        "label": "Org",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(temperature_celsius, org)",
        "query": "label_values(temperature_celsius, org)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(temperature_celsius{org=~\"$org\"}, location)",
        "query": "label_values(temperature_celsius{org=~\"$org\"}, location)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "deviceid",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(temperature_celsius{org=~\"$org\",location=~\"$location\"}, deviceid)",
        "query": "label_values(temperature_celsius{org=~\"$org\",location=~\"$location\"}, deviceid)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "time": { "from": "now-12h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "ESP32 MQTT Telemetry",
  "uid": "esp32-mqtt-telemetry",
  "version": 1,
  "weekStart": ""
}
